# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# A long random string — used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Bcrypt hashes of the staff passwords — generate each with:
#   node scripts/hash-password.js "your-chosen-password"
# then paste the printed hash below. Do not put the plaintext password here.
# STAFF_PASSWORD_HASH_2 is optional — leave it blank if you only want one password.
# Either password logs a staff member into the same shared results view.
STAFF_PASSWORD_HASH_1=
STAFF_PASSWORD_HASH_2=

# Set to "production" when deployed behind HTTPS so session cookies require it.
NODE_ENV=development

# Optional: where the SQLite file lives. On most hosts you'll point this at a
# mounted persistent disk, e.g. /data/data.sqlite — see README for details.
DB_PATH=./data.sqlite

# Optional: where daily backup snapshots are written. Point this at the same
# persistent disk as DB_PATH so backups survive redeploys, e.g. /data/backups.
BACKUP_DIR=./backups
